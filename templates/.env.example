# ==============================================================================
# Environment Configuration Template
# Instructions: Copy this file to `.env` and fill in local secrets.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# AI / LLM Provider Keys (uncomment and populate as needed)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Database / Storage (if applicable)
# DATABASE_URL=sqlite:///./app.db
